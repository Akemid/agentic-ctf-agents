    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "ctfagents"
  },
  "runtimes": [
    {
      "name": "harness",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/harness/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 900,
        "maxLifetime": 14400
      }
    },
    {
